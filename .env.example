# SeaweedFS / S3-compatible storage
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=weather-bucket
S3_USE_SSL=false

# Open-Meteo (no key required, kept here only for base URLs / overrides)
OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# Pipeline settings
CITIES=Jakarta,Surabaya,Bandung,Medan,Semarang,Makassar,Palembang,Depok,Tangerang,Tangerang Selatan,Bekasi,Batam,Bogor,Pekanbaru,Bandar Lampung,Padang,Malang,Denpasar,Samarinda,Banjarmasin
